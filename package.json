{
  "name": "ai-briefing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bash deploy/pull-db.sh --if-missing",
    "dev": "BRIEFING_DB=${BRIEFING_DB:-data/briefing.db} vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test 'ingest/*.test.js'",
    "deploy": "bash deploy/deploy.sh",
    "db:pull": "bash deploy/pull-db.sh",
    "db:migrate": "BRIEFING_DB=${BRIEFING_DB:-data/briefing.db} node ingest/pull.js --migrate"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/adapter-node": "^6.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "daisyui": "^5.7.47",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
