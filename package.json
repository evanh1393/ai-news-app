{
  "name": "ai-briefing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "bash deploy/pull-db.sh --if-missing",
    "dev": "BRIEFING_DB=${BRIEFING_DB:-data/briefing.db} vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test 'ingest/*.test.js' && vitest run",
    "deploy": "bash deploy/deploy.sh",
    "db:pull": "bash deploy/pull-db.sh",
    "db:migrate": "BRIEFING_DB=${BRIEFING_DB:-data/briefing.db} node ingest/pull.js --migrate"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@sveltejs/adapter-node": "^6.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "daisyui": "^5.7.50",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4"
  },
  "imports": {
    "#lib/*": "./src/lib/*",
    "#shared/*": "./shared/*"
  },
  "overrides": {
    "postcss-selector-parser": "^6.1.5"
  }
}
