#!/usr/bin/env bash
# Login shell for the newsbot user on CT 101. Whatever command Grok Bot sends, this only accepts
# a gzipped tar on stdin holding briefing.db and README.md, and swaps them in atomically.
set -euo pipefail
umask 027

R=/opt/ai-briefing
IN=$(mktemp -d)
trap 'rm -rf "$IN"' EXIT

# Cap the upload so a bad tarball can't fill the disk. Only these two names are extracted.
head -c 100M | tar -xzf - -C "$IN" --no-same-owner --no-same-permissions briefing.db README.md

for f in briefing.db README.md; do
  if [[ ! -f "$IN/$f" || -L "$IN/$f" ]]; then
    echo "briefing-upload: $f missing or not a regular file" >&2
    exit 1
  fi
done
if [[ $(head -c 15 "$IN/briefing.db") != "SQLite format 3" ]]; then
  echo "briefing-upload: briefing.db is not a SQLite database" >&2
  exit 1
fi

# data/ is setgid briefing, so the DB lands as newsbot:briefing 640 and the app can read it.
install -m 640 "$IN/briefing.db" "$R/data/.briefing.db.tmp"
mv -f "$R/data/.briefing.db.tmp" "$R/data/briefing.db"
install -m 644 "$IN/README.md" "$R/docs/.README.md.tmp"
mv -f "$R/docs/.README.md.tmp" "$R/docs/README.md"
echo "briefing-upload: ok"
