[Unit]
Description=AI Briefing SvelteKit app (adapter-node)
After=network-online.target
Wants=network-online.target

[Service]
User=briefing
Group=briefing
WorkingDirectory=/opt/ai-briefing/app
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=BRIEFING_DB=/opt/ai-briefing/data/briefing.db
Environment=NODE_OPTIONS=--disable-warning=ExperimentalWarning
ExecStart=/usr/bin/node build
Restart=always
RestartSec=3

# Sandbox. The app reads the DB and answers cloudflared on loopback; it needs nothing else.
# Everything is read-only to it, including its own code.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# No network beyond loopback: cloudflared reaches it on 127.0.0.1, and it calls nothing outside.
IPAddressDeny=any
IPAddressAllow=localhost
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
