[Unit]
Description=AI Briefing SvelteKit app (adapter-node)
After=network-online.target
Wants=network-online.target

[Service]
User=briefing
Group=briefing
WorkingDirectory=/opt/ai-briefing/app
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
Environment=ORIGIN=https://ai-briefing.taila927a9.ts.net
Environment=BRIEFING_DB=/opt/ai-briefing/data/briefing.db
Environment=NODE_OPTIONS=--disable-warning=ExperimentalWarning
ExecStart=/usr/bin/node build
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
