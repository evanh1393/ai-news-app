# Loaded as root by ai-briefing-app.service (ExecStartPre) before the app starts.
# The app only answers Caddy over loopback, so block every other outbound connection from the
# briefing user: tailnet, LAN and internet. systemd's IPAddressDeny would do this, but CT 101
# is an LXC container without cgroup BPF, where systemd silently ignores it.
destroy table inet ai_briefing_egress
table inet ai_briefing_egress {
	chain output {
		type filter hook output priority filter; policy accept;
		oif "lo" accept
		meta skuid "briefing" reject
	}
}
