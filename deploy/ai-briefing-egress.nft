# Loaded as root (ExecStartPre) by ai-briefing-app.service and briefing-pull.service.
# The app only answers Caddy over loopback, and Caddy only proxies to the app, so block every
# other outbound connection from the briefing and caddy users: tailnet, LAN and internet.
# systemd's IPAddressDeny would do this, but CT 101 is an LXC container without cgroup BPF,
# where systemd silently ignores it.
# briefing-pull only needs DNS and HTTPS to Google (oauth2/www.googleapis.com). Google's IPs move,
# so this pins ports, not addresses.
destroy table inet ai_briefing_egress
table inet ai_briefing_egress {
	chain output {
		type filter hook output priority filter; policy accept;
		oif "lo" accept
		meta skuid "briefing" reject
		meta skuid "caddy" reject
		meta skuid "briefing-pull" meta l4proto { udp, tcp } th dport 53 accept
		meta skuid "briefing-pull" tcp dport 443 accept
		meta skuid "briefing-pull" reject
	}
}
