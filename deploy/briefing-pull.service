[Unit]
Description=Pull Grok Bot's briefing markdown from Google Drive into briefing.db
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

# Runs the ingest container (compose.yaml), which is sandboxed there: read-only, no capabilities,
# drive-key.json mounted read-only, and only the data volume writable.
[Service]
Type=oneshot
WorkingDirectory=/opt/ai-briefing/compose
ExecStart=/usr/bin/docker compose run --rm --no-TTY ingest
TimeoutStartSec=5min
